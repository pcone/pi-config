#!/usr/bin/env bash
# pre-push: three landing refusals, nothing else (owner ruling 2026-11-18, pi-config#20 option A).
#
# (A) A push carrying the mainline ref must push HEAD itself: a landing is a mainline push by
#     definition, so a mainline line whose sha is not HEAD is a landing that reports success
#     while pushing something else.
#
#     (A2) covers what (A) cannot see: when git hands the hook no refs at all it prints
#     "Everything up-to-date" and reports success, so a landing made from a detached HEAD
#     strands its commits with no line to judge. That was WO-2026-102's first push; refusing
#     when HEAD is detached off the mainline is the owner's ruling (2026-11-19, Q-103-a).
# (B) A push may not add a work-orders/ id that a live ref of an unrelated line already holds
#     (rules/work-order-numbering.md). "Adds" is measured against the ref's old tip, or for a
#     new ref against the commits no other ref holds; a ref this push descends from is not a
#     rival, so a merge landing its branch's ids is not refused.
# (C) A push that moves the mainline must keep its previous tip on the pushed tip's first-parent
#     line: a direct commit on it, or a merge made from it. Git takes a merge of the old tip into
#     local work as a fast-forward, so only this rule refuses it. The same rule covers the other
#     direction: a pushed tip that is an ancestor of the previous one drops landings from the line,
#     and git takes that with --force, so only this rule refuses it (APPEND_SYSTEM § Landing work).
#
# The mainline is the calling repo's, never a literal: `git config pi.mainline` (pi-config:
# main, tfd: hamster). Unset is a hard error, not a default — a gate that quietly picks the
# wrong branch is the failure this file exists to prevent.
#
# Installation is a relative symlink (`.git/hooks/pre-push -> ../../bin/pre-push`), so the gate
# tracks the worktree; measure across commits by copying the file out first. `bin/setup` installs it.
#
# Narrow on purpose: a push carrying no mainline ref passes the landing rules silently (a side
# branch, a keep ref, a restore), and rule (B) reads only work-orders/ paths the push adds.
# `git push --no-verify` bypasses the hook, as git intends. What no clone can see: a claim in
# another session's detached HEAD or in a ref nobody has fetched.
set -u

zero=0000000000000000000000000000000000000000

# Every git call here fails hard. A gate that treats an unreadable ref as "nothing to refuse"
# is the fallback class decisions/subagents forbids: the state has an answer (abort, named),
# and guessing it leaves the push looking checked.
die() { echo "pre-push: $1" >&2; echo "  Push aborted; nothing was checked." >&2; exit 1; }

mainline_branch=$(git config --get pi.mainline) || die "pi.mainline is not set for this repo.
  Set it once per clone: git config --local pi.mainline <branch>
  (pi-config: main, tfd: hamster — scripts/change_scope.py owns tfd's value.)"
[ -n "$mainline_branch" ] || die "pi.mainline is empty; set it to this repo's mainline branch."
mainline_ref="refs/heads/$mainline_branch"

pushed=$(cat)

# ── (A2) nothing pushed at all ────────────────────────────────────────────────
if [ -z "$pushed" ]; then
    if git symbolic-ref -q HEAD >/dev/null; then
        exit 0   # on a branch: git had nothing to send, which is ordinary
    fi
    if ! head_sha=$(git rev-parse --verify --quiet HEAD); then
        exit 0   # unborn HEAD: no commit exists to strand
    fi
    mainline_sha=$(git rev-parse --verify --quiet "$mainline_ref") \
        || die "local $mainline_ref does not exist, so HEAD ($head_sha) cannot be placed."
    git merge-base --is-ancestor "$head_sha" "$mainline_sha"
    case $? in
        0) exit 0 ;;   # detached on the mainline's history: a read-only checkout
        1)
            echo "NOT LANDED: nothing to push, and HEAD is not on $mainline_ref." >&2
            echo "  HEAD is   $head_sha" >&2
            echo "  $mainline_branch is   $mainline_sha" >&2
            echo "  This push sends nothing. Cut a branch at HEAD and push that." >&2
            exit 1 ;;
        *) die "git merge-base failed placing HEAD ($head_sha) against $mainline_ref." ;;
    esac
fi

# ── (A) a mainline line that is not HEAD ──────────────────────────────────────
pushed_refs=$(printf '%s\n' "$pushed" | awk 'NF==4 {print $1}')
pushed_shas=$(printf '%s\n' "$pushed" | awk 'NF==4 {print $2}')

target=$(printf '%s\n' "$pushed" | awk -v ref="$mainline_ref" '$3 == ref {print $2; exit}')
if [ -n "$target" ]; then
    if [ "$target" = "$zero" ]; then
        echo "NOT LANDED: this push deletes $mainline_ref." >&2
        echo "  Deleting the mainline is not a landing; do it deliberately with --no-verify." >&2
        exit 1
    fi
    head_sha=$(git rev-parse HEAD) || die "cannot read HEAD."
    if [ "$target" != "$head_sha" ]; then
        echo "NOT LANDED: this checkout is not on the commit being pushed to $mainline_ref." >&2
        echo "  pushing   ${target}" >&2
        echo "  HEAD is   ${head_sha}" >&2
        echo "  Cut a branch at the commit you mean to land and push from it." >&2
        exit 1
    fi
fi

# ── (C) the previous mainline tip is on the pushed tip's first-parent line ────
# The oldest commit of the first-parent walk from the tip down to the old tip must have the old
# tip as its first parent. A walk that meets an ancestor of the old tip first has a foxtrot shape.
# A created mainline ref has no old tip to judge.
old=$(printf '%s\n' "$pushed" | awk -v ref="$mainline_ref" '$3 == ref {print $4; exit}')
if [ -n "$target" ] && [ "$old" != "$zero" ]; then
    span=$(git rev-list --first-parent "$old..$target") \
        || die "cannot diff $mainline_ref ($old) against $target."
    if [ -z "$span" ]; then
        # Empty span: every commit the pushed tip reaches is one the previous tip also reaches, so
        # the push moves the mainline backwards. Equal shas are a re-push of what is already there
        # and nothing to judge; an ancestor is a rewind that takes landed commits off the line.
        if [ "$target" != "$old" ]; then
            echo "NOT LANDED: this push rewinds $mainline_ref to an ancestor of its previous tip, which drops landings from the line (R98)." >&2
            echo "  previous tip is ${old}" >&2
            echo "  pushing        ${target}" >&2
            echo "  Land the change forward: commit what undoes it on top of ${old} and push that," >&2
            echo "  instead of moving $mainline_branch back." >&2
            exit 1
        fi
    else
        oldest=$(printf '%s\n' "$span" | tail -n 1)
        oldest_parents=$(git log -1 --format=%P "$oldest") \
            || die "cannot read the parents of $oldest."
        if [ "${oldest_parents%% *}" != "$old" ]; then
            echo "NOT LANDED: the previous $mainline_ref tip is not on the first-parent line of the commit pushed to it — a foxtrot merge, so the landing does not build on it (R98)." >&2
            echo "  previous tip is ${old}" >&2
            echo "  pushing        ${target}" >&2
            echo "  Rebase unpushed direct commits onto the previous tip (git pull --rebase), or rebase the" >&2
            echo "  branch and merge it --no-ff from a detached $mainline_branch tip." >&2
            exit 1
        fi
    fi
fi

# ── (B) an added work-orders/ id held by an unrelated line ────────────────────
# Live refs as `<commit> <ref name>`, deduped by commit: aliases and remote-tracking copies
# share a sha, and the scan is one `ls-tree` per entry. Full `%(refname)`, because the names on
# stdin are fully qualified.
held_refs() {
    git for-each-ref --format='%(objectname) %(refname)' refs/heads refs/remotes refs/tags \
        || die "cannot list refs."
}

# Commits held only by refs this push does not carry — the base a new ref's added set is
# measured against, and the exclusion arm of the scan. Computed on first use.
other_shas() {
    local out st
    out=$(held_refs | awk '{print $1}' | grep -vxF -f <(printf '%s\n' $pushed_shas))
    st=$?
    # grep 1 is "nothing left", which is an answer (this push holds every ref); 2 is a failure.
    [ "$st" -le 1 ] || return 1
    [ -z "$out" ] || printf '%s\n' "$out"
}

# Computed once, with its status checked: a failure inside `$( )` prints but does not abort the
# caller, and a gate that carries on after a failed read is the fallback this file must not have.
others=$(other_shas) || die "cannot list the refs this push does not carry."

# What this push adds under work-orders/. `--no-renames` because the reserve step renumbers by
# renaming a file: with rename detection the new path is R, not A, and the id slips through.
added_ids=$(
    while read -r local_ref local_sha remote_ref remote_sha; do
        [ -z "${remote_ref:-}" ] && continue
        [ "$local_sha" = "$zero" ] && continue   # a delete adds nothing
        if [ "$remote_sha" = "$zero" ]; then
            git log --no-renames --format= --name-only --diff-filter=A "$local_sha" \
                --not $others -- work-orders/ \
                || die "cannot read the commits of $local_ref."
        else
            git diff --no-renames --name-only --diff-filter=A "$remote_sha" "$local_sha" -- work-orders/ \
                || die "cannot diff $remote_ref ($remote_sha) against $local_sha."
        fi
    done <<< "$pushed"
) || exit 1

case "$added_ids" in
    *WO-*) : ;;
    *) exit 0 ;;
esac

ids=$(printf '%s\n' "$added_ids" | grep -o 'WO-[0-9]\{4\}-[0-9]\{3\}' | sort -u)
[ -z "$ids" ] && exit 0

# Every work-orders/ path a live ref ever added, with the commit and the ref that added it, in
# one process: `--source` names the ref, `--all` covers heads, remotes and tags. This replaces a
# per-ref `ls-tree` walk that cost 42 s in a 607-ref repo (tfd) and 12 s even after deduping by
# tree — a gate nobody can afford to leave on.
# `--branches --remotes --tags`, not `--all`: `--all` includes `refs/worktrees/*`, the pseudo-refs
# a tooling worktree leaves behind (tfd's validator materialises one per push), and a scratch
# checkout is not a line anyone claims an id on.
held_adds=$(git log --branches --remotes --tags --no-renames --diff-filter=A --name-only \
    --format='%H %S' -- work-orders/) || die "cannot read the work-orders history of the live refs."
held_pairs=$(printf '%s\n' "$held_adds" | awk '
    NF == 2 { commit = $1; ref = ($2 == "" ? $1 : $2); next }
    /^work-orders\// { print commit "\t" ref "\t" $0 }')

# A commit this push descends from is lineage, not a rival: a merge landing its branch's ids, or
# a branch that merged the mainline, holds ids from its own history.
is_ancestor_of_pushed() {
    local tip=$1 sha
    for sha in $pushed_shas; do
        git merge-base --is-ancestor "$tip" "$sha" && return 0
    done
    return 1
}

refused=0
while read -r id; do
    [ -z "$id" ] && continue
    while IFS=$'\t' read -r commit ref path; do
        [ -z "$path" ] && continue
        case "$path" in
            *"$id"[-.]*) ;;
            *) continue ;;
        esac
        case " $pushed_refs " in *" $ref "*) continue ;; esac
        is_ancestor_of_pushed "$commit" && continue
        echo "NOT LANDED: $id is already held by $ref." >&2
        refused=1
        break
    done <<< "$held_pairs"
done <<< "$ids"

[ "$refused" = 0 ] && exit 0
echo "  Renumber to an id no live ref holds (rules/work-order-numbering.md), then push." >&2
exit 1
