{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "theme": "catppuccin-macchiato",
  "extensions": [
    "extensions/checkpoint.ts",
    "extensions/go.ts",
    "extensions/footer-session-id.ts",
    "extensions/session-name.ts",
    "extensions/auto-checkpoint.ts",
    "extensions/subagent-async/index.ts",
    "extensions/kagi-search.ts",
    "extensions/model-tiers/index.ts",
    "extensions/compaction-model.ts",
    "extensions/peer-link/index.ts",
    "extensions/append-system-local.ts",
    "extensions/pinned-sessions.ts",
    "extensions/bug-triage.ts",
    "~/.pi/local-extensions/session-icon.ts"
  ],
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "httpIdleTimeoutMs": 0,
  "shellCommandPrefix": "shopt -s expand_aliases"
}